{
  "qualification": "source-only; published major-1 IR bundle is incompatible",
  "snapshot_record": "docs/foundation-snapshot.md",
  "ir_format": { "major": 2, "minor": 2 },
  "nix_authority_version": 1,
  "native_nix_lock_version": 7,
  "nix_features": ["raw", "sources", "builds", "workflows"],
