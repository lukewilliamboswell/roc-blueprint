((format ((major 2) (minor 7)))
 (name "explicit")
 (requires ("explicit-sources" "programs" "expects"))
 (systems ("x86_64-linux" "aarch64-linux"))
 (sources (((name "nix") (provider (NixPackages "github:NixOS/nixpkgs/nixos-unstable")))))
 (inputs (((name "zig") (urls ("github:mitchellh/zig-overlay")) (kind Overlay))))
 (programs (((name "roc-stable") (system "x86_64-linux") (urls ("https://example.test/roc-x86_64.tar.gz")) (unpack TarGz) (path "roc/roc"))
            ((name "roc-stable") (system "aarch64-linux") (urls ("https://example.test/roc-arm64.tar.gz")) (unpack TarGz) (path "roc/roc"))))
 (environments (((name "dev") (parents ()) (tools ()) (overlays ()))
                ((name "host") (parents ("dev")) (tools (((source "nix") (name "zigpkgs.\"0.16.0\"")))) (overlays ("zig")))))
 (environment_programs (((environment "dev") (programs ("roc-stable")))))
 (expects (((environment "dev") (programs ("git")))))
 (tasks (((name "check") (environment "dev") (run ("scripts/check_all.roc")))
         ((name "host") (environment "host") (run ("zig" "build"))))))
