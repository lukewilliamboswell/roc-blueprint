((format ((major 2) (minor 7)))
 (name "programs")
 (requires ("programs"))
 (systems ("x86_64-linux" "aarch64-darwin" "x86_64-windows"))
 (programs (((name "roc-stable") (system "x86_64-linux")
             (url "https://github.com/roc-lang/nightlies/releases/download/nightly-2026-10-04-130536d/roc_nightly-linux_x86_64-2026-10-04-130536d.tar.gz")
             (unpack TarGz) (path "roc_nightly-linux_x86_64-2026-10-04-130536d/roc"))
            ((name "roc-stable") (system "aarch64-darwin")
             (url "https://github.com/roc-lang/nightlies/releases/download/nightly-2026-10-04-130536d/roc_nightly-macos_apple_silicon-2026-10-04-130536d.tar.gz")
             (unpack TarGz) (path "roc_nightly-macos_apple_silicon-2026-10-04-130536d/roc"))
            ((name "roc-stable") (system "x86_64-windows")
             (url "https://github.com/roc-lang/nightlies/releases/download/nightly-2026-10-04-130536d/roc_nightly-windows_x86_64-2026-10-04-130536d.zip")
             (unpack Zip) (path "roc_nightly-windows_x86_64-2026-10-04-130536d/roc.exe"))
            ((name "notes") (system "x86_64-linux") (url "https://example.test/notes-1.0.tar.xz") (unpack TarXz) (path "notes-1.0/bin/notes"))
            ((name "tool") (system "x86_64-linux") (url "https://example.test/releases/1.0/tool-x86_64-linux") (unpack File) (path ""))
            ((name "tool") (system "aarch64-darwin") (url "https://example.test/releases/1.0/tool-aarch64-darwin") (unpack File) (path ""))))
 (environments (((name "base") (parents ()) (tools ()) (overlays ()))
                ((name "dev") (parents ("base")) (tools ()) (overlays ()))))
 (environment_programs (((environment "base") (programs ("roc-stable")))
                        ((environment "dev") (programs ("tool" "roc-stable" "notes")))))
 (tasks (((name "check") (environment "dev") (run ("scripts/check_all.roc"))))))
