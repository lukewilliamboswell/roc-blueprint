((format ((major 3) (minor 6)))
 (resolvers (((provider "nix") (inputs ("roc" "utils")))))
 (name "full")
 (requires ("raw" "configured-tools"))
 (systems ("x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin"))
 (sources (((name "default")
            (provider ((name "nix") (version 1) (ref "github:NixOS/nixpkgs/nixos-unstable"))))
           ((name "stable")
            (provider ((name "nix") (version 1) (ref "github:NixOS/nixpkgs/nixos-24.05"))))))
 (inputs (((name "roc") (url "github:roc-lang/roc-overlay"))
          ((name "utils") (url "github:numtide/flake-utils"))))
 (environments (
   ((name "dev") (parents ())
    (tools (((source "default") (name "hello"))
            ((source "stable") (name "jq")))) (overlays ("roc")))
   ((name "empty") (parents ()) (tools ()) (overlays ()))
   ((name "headless") (parents ())
    (tools (((source "stable") (name "jq")))) (overlays ()))))
 (configured_tools (((environment "headless")
                     (tool ((source "stable") (name "rust-bin.stable.\"1.95.0\".default")))
                     (options (Attrs (((name "targets") (value (List ((Str "x86_64-unknown-linux-musl")))))
                                      ((name "extensions") (value (List ((Str "rust-src")))))))))))
 (shells (((name "default") (environment "dev"))
          ((name "empty") (environment "empty"))))
 (tasks (((name "greet") (environment "headless") (run ("jq" "--version")))))
 (raw (((backend "nix") (target "shell:default")
        (value (Attrs (((name "shellHook") (value (Str "echo \"hi ${USER}\"\nexport FOO=bar\n")))
                       ((name "GREETING") (value (Str "hello")))))))
       ((backend "nix") (target "flake")
        (value (Attrs (((name "blueprint") (value (Attrs (((name "version") (value (Int 1)))))))))))
       ((backend "guix") (target "whatever") (value (Int 0))))))
