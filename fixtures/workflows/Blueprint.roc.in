# The suite supplies the local platform, the pinned inputs and the event log.
app [config] {
	pf: platform "@PLATFORM@",
}

config = [
	Name("workflow-integration"),
	Systems(["x86_64-linux"]),
	Packages("default", From(NixPackages("@PACKAGES@"))),
	Packages("foreign", From(GuixPackages("https://example.invalid/guix"))),
	Overlay("roc", "@ROC_OVERLAY@"),
	# Tasks and builds are Roc scripts: one pinned compiler and the bundles
	# those scripts name, and no other tool. Roc takes the first `--` for
	# itself, so each command has one before the script's arguments.
	Environment("builder", [Overlays(["roc"]), Command("roc-stable", "rocpkgs.@ROC_COMPILER@"), RocPackages([@ROC_PACKAGES@])]),
	Environment("foreign", [Tools(["foreign#python"])]),
	Source("assets", "path:./assets"),
	Task("record", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "record", "configured argument"])]),
	Task("prepare", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "prepare"])]),
	Task("edit", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "edit"])]),
	Task("dirty", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "dirty"])]),
	Task("fail", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "fail"])]),
	Task("later", [Use("builder"), Run(["roc-stable", "task.roc", "--", "@EVENTS@", "record", "unsupported task reached"])]),
	Build("library", [Use("builder"), Run(["roc-stable", "build.roc", "--", "library"]), Output("dist/library")]),
	Build(
		"app",
		[
			Use("builder"),
			Inputs(["assets"]),
			Needs(["library"]),
			Run(["roc-stable", "build.roc", "--", "app", "", "two words", "--", "--literal", "$HOME", "$(touch INJECTED)", "; touch INJECTED", "a'b\"c", "line\nbreak", "*", "$"]),
			Output("dist/app"),
		],
	),
	Build("fail", [Use("builder"), Run(["roc-stable", "build.roc", "--", "fail"]), Output("dist/fail")]),
	Build("later-library", [Use("builder"), Run(["roc-stable", "build.roc", "--", "library"]), Output("dist/library")]),
	Build("later-app", [Use("builder"), Needs(["later-library"]), Run(["roc-stable", "build.roc", "--", "fail"]), Output("dist/fail")]),
	Workflow("empty", []),
	Workflow("nested-empty", [RunWorkflow("empty"), RunWorkflow("empty")]),
	Workflow("ci", [RunTask("prepare", []), BuildArtifact("app"), RunTask("record", ["after build"])]),
	Workflow(
		"leaf",
		[RunTask("record", ["", "two words", "--", "--literal", "$HOME", "$(touch INJECTED)", "; touch INJECTED", "a'b\"c", "line\nbreak", "*", "$"])],
	),
	Workflow("middle", [RunWorkflow("leaf"), RunTask("record", ["middle"]), RunWorkflow("leaf")]),
	Workflow("nested", [RunTask("record", ["first"]), RunWorkflow("middle"), RunWorkflow("leaf"), RunTask("record", ["last"])]),
	Workflow("fresh", [BuildArtifact("app"), RunTask("edit", []), BuildArtifact("app"), RunTask("record", ["after refresh"])]),
	Workflow("repeat", [BuildArtifact("app"), RunTask("record", ["unchanged"]), BuildArtifact("app")]),
	Workflow("task-failure", [RunTask("record", ["before failure"]), RunTask("fail", []), BuildArtifact("app"), RunTask("record", ["must not run"])]),
	Workflow("build-failure", [RunTask("record", ["before failure"]), BuildArtifact("fail"), RunTask("record", ["must not run"]), BuildArtifact("app")]),
	Workflow("dirty-source", [BuildArtifact("app"), RunTask("dirty", []), BuildArtifact("app"), RunTask("record", ["must not run"])]),
	Workflow("unsupported-tail", [RunTask("later", [])]),
	Workflow("unsupported-task", [RunTask("record", ["must not run"]), RunWorkflow("unsupported-tail")]),
	Workflow("unsupported-build", [RunTask("record", ["must not run"]), BuildArtifact("later-app")]),
]
